#!/bin/sh
# LegacyPodClaw post-install script

PREFS=/var/mobile/Library/Preferences/pro.matthesketh.legacypodclaw.plist
SHARED=/var/mobile/Library/LegacyPodClaw
DAEMON=/Library/LaunchDaemons/pro.matthesketh.legacypodclaw.daemon.plist

# files owned by mobile need no extra group; undo the clawpod group that 0.3.0 created
if grep -q '^clawpod:' /etc/group 2>/dev/null; then
    grep -v '^clawpod:' /etc/group > /etc/group.lpc && cat /etc/group.lpc > /etc/group && rm -f /etc/group.lpc
    for d in /var/mobile/Library/Notes /var/mobile/Library/Calendar /var/mobile/Library/SMS \
             /var/mobile/Media/iTunes_Control/iTunes /var/mobile/Media/iTunes_Control/Music; do
        [ -d "$d" ] && chgrp -R mobile "$d" 2>/dev/null
    done
fi

# files the app, settings and springboard pass to each other
mkdir -p "$SHARED"
chown mobile:mobile "$SHARED"
chmod 700 "$SHARED"

# settings hold the api base url, so only mobile may read or write them
if [ -f "$PREFS" ]; then
    chown mobile:mobile "$PREFS"
    chmod 600 "$PREFS"
fi

# load the new daemon binary and mach services; prerm unloaded the old one
launchctl unload "$DAEMON" 2>/dev/null
launchctl load "$DAEMON"

# ask cydia to restart springboard, so the new tweak loads
if [ -n "$CYDIA" ]; then
    eval "echo 'finish:restart' >&${CYDIA%% *}"
fi

exit 0
